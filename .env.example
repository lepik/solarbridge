# SolarBridge 0.9.0 — пример .env с полными комментариями.
# Копируйте в .env и правьте под себя; либо используйте install.py (он
# генерирует .env сам, с учётом роли). Всё регулируется переменными ниже.

# ============================ ОБЩЕЕ (обе роли) ==============================

# Роль этой машины:
#   serial  — мастер: опрашивает инвертор по RS485 и рассылает кадры приёмникам
#   ingest  — приёмник: принимает кадры от мастера и зеркалит их в свою БД
SB_SOURCE_MODE=serial

# Идентификатор мастера, по которому помечаются все кадры.
# По умолчанию hostname. НЕ меняйте задним числом: кадры в БД приёмника
# дедуплицируются по паре (master_id, время кадра).
# SB_MASTER_ID=raspberrypi

# Адрес и порт веб-интерфейса.
# 127.0.0.1 — доступ только с этой машины (поставьте nginx спереди для HTTPS);
# 0.0.0.0 — доступ из сети.
SB_DASH_HOST=127.0.0.1
SB_DASH_PORT=8090

# Путь к базе данных (относительные пути считаются от каталога проекта).
# SB_DB_PATH=data/solarbridge.sqlite3

# Глубина истории в днях. При кадре раз в 60 секунд:
#   730 дней ~ 7,6 ГБ  |  365 дней ~ 3,8 ГБ  |  60 дней ~ 0,6 ГБ
# На SD-карте 16 ГБ безопасный дефолт — 365.
SB_RETENTION_DAYS=730

# Свежесть пересева (seed) в днях: seed старше этого отклоняется приёмником.
# 0 = равно окну догрузки (SB_FORWARD_BACKFILL_DAYS).
SB_SEED_MAX_AGE_DAYS=0

# ============================ МАСТЕР (serial) ===============================

# Стабильный путь переживает смену ttyUSB-номеров: by-id (по USB-серийнику)
# или by-path (по физическому USB-гнезду — надёжно для одинаковых адаптеров
# без серийника). Список: ls -l /dev/serial/by-id/ /dev/serial/by-path/
SB_SERIAL_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
# SB_SERIAL_PORT=/dev/serial/by-path/platform-3f980000.usb-usb-0:1.5:1.0-port0
SB_SLAVE_ID=4
SB_BAUDRATE=19200

# Циклы: опрос шины каждые 15 с; запись кадра в БД каждые 60 с (кадр = сэмпл =
# пересылаемая единица); read-only конфиги инвертора каждые 300 с.
SB_POLL_INTERVAL=15
SB_SAMPLE_INTERVAL=60
SB_CONFIG_INTERVAL=300
SB_SERIAL_TIMEOUT=2.5
SB_INTER_REQUEST_DELAY=0.5

# ---- Пересылка на приёмники ----
# Список приёмников — файл receivers.list рядом с .env (см. receivers.list.example).
# Управляется через install.py: «Добавить приёмник» генерирует токен сам.
# SB_RECEIVERS_FILE=receivers.list

# Окно догрузки: приёмник, отставший меньше чем на это, получает пропущенные
# кадры автоматически (старые → новые, батчами). Отставший сильнее окна
# помечается reseed_required и требует пересева. 0 = только live-кадры.
SB_FORWARD_BACKFILL_DAYS=60

# Батч догрузки (сэмплов; 240 ~ 0,5 МБ gzip), пауза между батчами (сек),
# максимум одновременных догрузок.
SB_FORWARD_BATCH=240
SB_FORWARD_PAUSE_S=1.0
SB_FORWARD_PARALLEL=2

# Heartbeat (статусный кадр с состоянием шины) каждые N секунд; приёмник
# считает мастера offline, если heartbeat нет 45 с (3 интервала), а данные
# устаревшими — если кадров нет SB_OFFLINE_AFTER_S секунд (по умолчанию 180).
SB_HEARTBEAT_INTERVAL=15
SB_OFFLINE_AFTER_S=180

# ---- Пересев (seed) ----
# Каталог снимков и ссылок (по умолчанию data/seeds).
# SB_SEED_DIR=data/seeds
# Ссылка живёт N часов и допускает до M скачиваний (докачка Range поддержана).
SB_SEED_TOKEN_TTL_HOURS=24
SB_SEED_TOKEN_MAX_DOWNLOADS=10

# ---- Батареи (экспериментально; по умолчанию выключено) ----
# MNB LPR-51.2-100 и родственные (PACE BMS ASCII "paceic" или PACE Modbus).
# Опрашивается ОТДЕЛЬНЫЙ USB-RS485 адаптер — шину инвертора не трогаем.
SB_BATTERY_MODE=off
# SB_BATTERY_SERIAL_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if02-port0
# SB_BATTERY_SERIAL_PORT=/dev/serial/by-path/platform-3f980000.usb-usb-0:1.4:1.0-port0
SB_BATTERY_BAUDRATE=9600
# auto = сначала ASCII (v25/v20), затем Modbus RTU (карта PACE V1.3)
SB_BATTERY_PROTOCOL=auto
# Для ASCII: v25 (родной PACE: VER=25/CID1=46/INFO=адрес), v20 (PACE "PYLON": 20/4A)
# или pylon (официальный Pylontech low voltage V3.3: VER=20/CID1=46/INFO=адрес —
# для настоящих Pylontech US2000/US3000).
# auto = проба со строгой проверкой VER (порядок v25 -> v20 -> pylon), вариант
# фиксируется по адресу.
# Внимание: реальные MNB отвечают v25 даже на v20-запросы — автопроба это учитывает.
# Дополнительно (один раз на модуль, необязательные) читаются 0x93 (серийный
# номер), 0x92 (пределы заряда/разряда) и 0x47 (пороги защит) из док. Pylon V3.3.
SB_BATTERY_VARIANT=auto
# DIP-адреса батарейных модулей через запятую, 1..15. Автоскана нет:
# адреса задаются ТОЛЬКО здесь (пример для двух модулей: 2,3).
# Пусто = мониторинг батарей не запускается.
SB_BATTERY_ADDRESSES=2,3
# Пауза между командами шины (Pylontech требует >= 1 с)
SB_BATTERY_CMD_GAP_S=1.0
SB_BATTERY_POLL_INTERVAL=15

# ============================ PC MASTER (09 / PC MASTER POLL) ================

# Метрики хоста мастера (CPU/температура, load, RAM, диск, throttled) в
# /api/current и в heartbeat для приёмников. 1 = включено (рекомендуется).
# Отключение (0) также прячет секцию «09 / PC MASTER POLL» на всех экранах.
SB_HOST_STATS=1

# ============================ ОБНОВЛЕНИЕ (update.py) =========================

# Источник релизов для `sudo python3 update.py`: репозиторий GitHub
# (https://github.com/owner/repo — берётся последний release с активом *.zip
# и *.zip.sha256) или прямой URL zip (рядом ожидается URL + ".sha256").
# Можно задавать разово флагом --url; если не задано — update.py откажется
# работать с плейсхолдером по умолчанию.
# SB_UPDATE_URL=

# ============================ ДАШБОРД: ВХОД И ДИСК ===========================

# 1 = страницы дашборда требуют вход по логину/паролю. Пары хранятся в файле
# user_list рядом с .env (формат "login:password", по одной на строку,
# открытый текст — держите права 0640). После входа браузер запоминает
# токен на 30 дней. 0 = дашборд без входа (как раньше).
SB_AUTH=0
# Путь к файлу логинов (необязательно; по умолчанию user_list рядом с .env)
# SB_USER_LIST=user_list

# Дисковый сторож мастера: если на разделе с БД свободно меньше этого
# процента, мастер прекращает писать кадры в свою БД и шлёт их напрямую
# приёмникам, а на дашборде появляется предупреждение. 0 = не проверять.
SB_DISK_MIN_FREE_PERCENT=10

# ============================ ПРИЁМНИК (ingest) =============================

# Токен этого приёмника — СВОЙ, совпадает с токеном строки в receivers.list
# мастера. Генерируется мастером (меню «Добавить приёмник»).
# SB_INGEST_TOKEN=

# IP-allowlist для /api/ingest/* и скачивания seed: IP или CIDR через запятую.
# Пусто = выключено. Токен обязателен в любом случае.
# SB_INGEST_ALLOWLIST=192.168.1.0/24,10.0.0.5

# 1 = брать клиентский IP из X-Forwarded-For (приёмник за nginx/reverse proxy).
SB_TRUST_PROXY=0
